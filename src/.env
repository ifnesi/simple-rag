# Configuration for the `mcp` container (loaded by docker-compose). No secrets live here.
# This file lists every environment variable the Python code reads. Lines starting with "#" show the
# default and can be uncommented to change it.
#
# The FAQ files are loaded once when the mcp container starts. After editing src/faqs or this file:
#   docker-compose up -d --force-recreate mcp     (a plain `restart` does not re-read this file)

# ---- Ollama: answer generation (rag_core.py) ----
# Where the container can reach Ollama. host.docker.internal = the machine running Docker/Colima.
# If Ollama runs elsewhere, put its URL here, e.g. http://192.168.1.20:11434
OLLAMA_URL=http://host.docker.internal:11434
# Any model you have pulled:  ollama pull <name>   (see `ollama list`)
OLLAMA_MODEL=gemma4:e4b-mlx
# Seconds to wait for an answer (the first call also loads the model into memory)
# OLLAMA_TIMEOUT=240

# ---- Embeddings (rag_core.py) ----
# Local model (fastembed). It is baked into the image at build time, so changing it also needs a rebuild:
#   docker-compose build --build-arg EMBED_MODEL=<name>
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Chunking and retrieval (rag_core.py) ----
# Each FAQ entry (a "Q:/A:" block or a "## question" section) is one chunk. CHUNK_SIZE is the maximum
# characters per chunk: a longer entry is split into windows that overlap by CHUNK_OVERLAP characters.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100
# Chunks retrieved per question when the caller does not say (1-10). app.py also reads this variable,
# but the web container does not load this file, so for the web UI it stays 4 (the UI sends top_k itself).
# TOP_K_DEFAULT=4
# TEMPERATURE=0
# MIN_SCORE=0.60
# CHAT_HISTORY_TURNS=3

# ---- Set by docker-compose.yml (values in compose win over this file) ----
# FAQ_DIR=/app/faqs                      # rag_core.py; outside Docker it defaults to src/faqs
# MCP_TRANSPORT=streamable-http          # mcp_server.py; "stdio" (default) or "streamable-http"
# MCP_HOST=0.0.0.0                       # mcp_server.py; HTTP bind address (default 127.0.0.1)
# MCP_PORT=8000                          # mcp_server.py; HTTP port (default 8000)
# MCP_URL=http://mcp:8000/mcp            # app.py (the `web` container); where the backend finds the MCP server
